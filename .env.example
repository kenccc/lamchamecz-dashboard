# Generate strong values before any non-DEBUG deploy.
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-random-64-chars
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Comma-separated full origins required when DJANGO_DEBUG=0, e.g. https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=lcm
POSTGRES_USER=lcm
POSTGRES_PASSWORD=lcm-change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

WEB_PORT=8000
CREATE_SUPERUSER=1
ADMIN_USERNAME=admin
# Required, min 12 chars, not on common-password list
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_FULLNAME=Administrator
